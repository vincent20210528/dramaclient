# Set default line ending behavior for files
* text=auto eol=crlf

# Explicitly declare text files you want to always be normalized and converted to native line endings on checkout
*.vue text eol=crlf
*.ts text eol=crlf
*.js text eol=crlf
*.json text eol=crlf
*.css text eol=crlf
*.scss text eol=crlf
*.html text eol=crlf
*.md text eol=crlf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

